          "documentation": "Un único sistema y tres terminadores. Las vistas repetidas representan el mismo Cliente, Sucursal o Red Central. Los flujos agrupan datos de la conversación: credenciales, resultados y comprobantes; ver DD."
        },
        {
          "_type": "DFDExternalEntity",
          "_id": "atm-000004",
          "_parent": {
            "$ref": "atm-000002"
          },
          "name": "Cliente"
        },
        {
          "_type": "DFDProcess",
          "_id": "atm-000005",
          "_parent": {
            "$ref": "atm-000002"
          },
          "name": "Cajero Automático",
          "id": "0"
        },
        {
          "_type": "DFDExternalEntity",
          "_id": "atm-000006",
          "_parent": {
            "$ref": "atm-000002"
          },
          "name": "Sucursal"
        },
        {
          "_type": "DFDExternalEntity",
          "_id": "atm-000007",
          "_parent": {
            "$ref": "atm-000002"
          },
          "name": "Red Central"
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000015",
          "_parent": {
            "$ref": "atm-000002"
          },
          "name": "Credenciales de autenticación",
          "documentation": "Datos aportados por el cliente para abrir una sesión.\nComposición: DatosTarjeta + pin",
          "source": {
            "$ref": "atm-000004"
          },
          "target": {
            "$ref": "atm-000005"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000018",
          "_parent": {
            "$ref": "atm-000002"
          },
          "name": "Solicitud de PIN",
          "documentation": "Pantalla que solicita el PIN después de validar tarjeta.\nComposición: numeroTarjeta + intentosRestantes",
          "source": {
            "$ref": "atm-000005"
          },
          "target": {
            "$ref": "atm-000004"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000021",
          "_parent": {
            "$ref": "atm-000002"
          },
          "name": "Resultado de autenticación",
          "documentation": "Respuesta de acceso y pantalla siguiente.\nComposición: estadoAutenticacion + mensaje + intentosRestantes + tarjetaDevuelta + [menu]",
          "source": {
            "$ref": "atm-000005"
          },
          "target": {
            "$ref": "atm-000004"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000028",
          "_parent": {
            "$ref": "atm-000002"
          },
          "name": "Solicitud de validación de tarjeta",
          "documentation": "Consulta del cajero al sistema de Sucursal.\nComposición: DatosTarjeta",
          "source": {
            "$ref": "atm-000005"
          },
          "target": {
            "$ref": "atm-000006"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000031",
          "_parent": {
            "$ref": "atm-000002"
          },
          "name": "Estado de tarjeta",
          "documentation": "Resultado enviado por Sucursal.\nComposición: estadoTarjeta + [numeroCuenta] + mensaje",
          "source": {
            "$ref": "atm-000006"
          },
          "target": {
            "$ref": "atm-000005"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000038",
          "_parent": {
            "$ref": "atm-000002"
          },
          "name": "Solicitud de validación de PIN",
          "documentation": "Verificación enviada a Red Central.\nComposición: numeroTarjeta + pin",
          "source": {
            "$ref": "atm-000005"
          },
          "target": {
            "$ref": "atm-000007"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000041",
          "_parent": {
            "$ref": "atm-000002"
          },
          "name": "Confirmación de PIN",
          "documentation": "Respuesta de Red Central a la autenticación.\nComposición: pinValido + mensaje",
          "source": {
            "$ref": "atm-000007"
          },
          "target": {
            "$ref": "atm-000005"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000044",
          "_parent": {
            "$ref": "atm-000002"
          },
          "name": "Solicitud de consulta",
          "documentation": "Elección de consulta de saldo.\nComposición: idSesion + numeroCuenta",
          "source": {
            "$ref": "atm-000004"
          },
          "target": {
            "$ref": "atm-000005"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000047",
          "_parent": {
            "$ref": "atm-000002"
          },
          "name": "Solicitud de consulta de saldo",
          "documentation": "Petición al sistema central.\nComposición: numeroCuenta",
          "source": {
            "$ref": "atm-000005"
          },
          "target": {
            "$ref": "atm-000007"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000050",
          "_parent": {
            "$ref": "atm-000002"
          },
          "name": "Información de saldo",
          "documentation": "Respuesta central de consulta.\nComposición: exito + saldoDisponible + saldoTotal + mensaje",
          "source": {
            "$ref": "atm-000007"
          },
          "target": {
            "$ref": "atm-000005"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000053",
          "_parent": {
            "$ref": "atm-000002"
          },
          "name": "Resultado de consulta",
          "documentation": "Saldo mostrado al cliente.\nComposición: ResultadoOperacion + [saldoDisponible] + [saldoTotal]",
          "source": {
            "$ref": "atm-000005"
          },
          "target": {
            "$ref": "atm-000004"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000056",
          "_parent": {
            "$ref": "atm-000002"
          },
          "name": "Solicitud de extracción",
          "documentation": "Monto y cuenta de una extracción.\nComposición: idSesion + numeroCuenta + monto",
          "source": {
            "$ref": "atm-000004"
          },
          "target": {
            "$ref": "atm-000005"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000059",
          "_parent": {
            "$ref": "atm-000002"
          },
          "name": "Solicitud de débito",
          "documentation": "Autorización y débito atómico en Red Central.\nComposición: numeroCuenta + monto",
          "source": {
            "$ref": "atm-000005"
          },
          "target": {
            "$ref": "atm-000007"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000062",
          "_parent": {
            "$ref": "atm-000002"
          },
          "name": "Resultado de débito",
          "documentation": "Confirmación o rechazo de débito.\nComposición: exito + [numeroTransaccion] + saldoRestante + mensaje",
          "source": {
            "$ref": "atm-000007"
          },
          "target": {
            "$ref": "atm-000005"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000065",
          "_parent": {
            "$ref": "atm-000002"
          },
          "name": "Resultado de extracción",
          "documentation": "Resultado mostrado y constancia de entrega de efectivo.\nComposición: ResultadoOperacion + montoEntregado + saldoRestante",
          "source": {
            "$ref": "atm-000005"
          },
          "target": {
            "$ref": "atm-000004"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000068",
          "_parent": {
            "$ref": "atm-000002"
          },
          "name": "Solicitud de transferencia",
          "documentation": "Datos y confirmación de una transferencia.\nComposición: idSesion + numeroCuenta + cbuDestino + monto + confirmacion",
          "source": {
            "$ref": "atm-000004"
          },
          "target": {
            "$ref": "atm-000005"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000071",
          "_parent": {
            "$ref": "atm-000002"
          },
          "name": "Instrucción de transferencia",
          "documentation": "Orden atómica a Red Central.\nComposición: numeroCuenta + cbuDestino + monto",
          "source": {
            "$ref": "atm-000005"
          },
          "target": {
            "$ref": "atm-000007"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000074",
          "_parent": {
            "$ref": "atm-000002"
          },
          "name": "Resultado central de transferencia",
          "documentation": "Resultado, confirmación y comprobante central.\nComposición: exito + [numeroComprobante] + saldoRestante + mensaje",
          "source": {
            "$ref": "atm-000007"
          },
          "target": {
            "$ref": "atm-000005"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000077",
          "_parent": {
            "$ref": "atm-000002"
          },
          "name": "Resultado de transferencia",
          "documentation": "Resultado y comprobante mostrado al cliente.\nComposición: ResultadoOperacion + [numeroComprobante] + saldoRestante",
          "source": {
            "$ref": "atm-000005"
          },
          "target": {
            "$ref": "atm-000004"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000080",
          "_parent": {
            "$ref": "atm-000002"
          },
          "name": "Solicitud de cierre",
          "documentation": "Decisión del cliente de finalizar la sesión.\nComposición: idSesion + deseaTicket",
          "source": {
            "$ref": "atm-000004"
          },
          "target": {
            "$ref": "atm-000005"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000083",
          "_parent": {
            "$ref": "atm-000002"
          },
          "name": "Resultado de cierre",
          "documentation": "Confirmación, ticket opcional y devolución de tarjeta.\nComposición: idSesion + tarjetaDevuelta + [Ticket] + estadoSesion",
          "source": {
            "$ref": "atm-000005"
          },
          "target": {
            "$ref": "atm-000004"
          }
        }
      ]
    }
  ]
