                    "$ref": "atm-001544"
                  },
                  "condition": "cliente solicita finalizar sesión",
                  "extensionLocations": [
                    {
                      "$ref": "atm-001579"
                    }
                  ]
                },
                {
                  "_type": "UMLExtend",
                  "_id": "atm-001583",
                  "_parent": {
                    "$ref": "atm-001547"
                  },
                  "source": {
                    "$ref": "atm-001547"
                  },
                  "target": {
                    "$ref": "atm-001545"
                  },
                  "condition": "cliente solicita finalizar sesión",
                  "extensionLocations": [
                    {
                      "$ref": "atm-001582"
                    }
                  ]
                },
                {
                  "_type": "UMLExtend",
                  "_id": "atm-001586",
                  "_parent": {
                    "$ref": "atm-001547"
                  },
                  "source": {
                    "$ref": "atm-001547"
                  },
                  "target": {
                    "$ref": "atm-001546"
                  },
                  "condition": "cliente solicita finalizar sesión",
                  "extensionLocations": [
                    {
                      "$ref": "atm-001585"
                    }
                  ]
                }
              ],
              "extensionPoints": [],
              "documentation": "Se extiende una operación cuando el cliente decide finalizar. Dentro del cierre el ticket es opcional, pero la devolución de tarjeta y el cierre de sesión son obligatorios. También puede iniciarse desde el menú sin operaciones previas."
            }
          ]
