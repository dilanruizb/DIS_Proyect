{
  "_type": "Project",
  "_id": "atm-001250",
  "name": "Cajero Automático — Casos de uso",
  "ownedElements": [
    {
      "_type": "UMLModel",
      "_id": "atm-001251",
      "_parent": {
        "$ref": "atm-001250"
      },
      "name": "Cajero Automático — Casos de uso",
      "ownedElements": [
        {
          "_type": "UMLUseCaseSubject",
          "_id": "atm-001252",
          "_parent": {
            "$ref": "atm-001251"
          },
          "name": "Cajero Automático",
          "ownedElements": [
            {
              "_type": "UMLUseCase",
              "_id": "atm-001256",
              "_parent": {
                "$ref": "atm-001252"
              },
              "name": "Autenticar Usuario",
              "ownedElements": [],
              "extensionPoints": [],
              "documentation": "Objetivo: garantizar una sesión autenticada. Si la sesión ya está autenticada, devolver su contexto sin pedir nuevamente tarjeta/PIN. En caso contrario validar tarjeta en Sucursal y PIN en Central; máximo tres intentos. No persistir PIN."
            },
            {
              "_type": "UMLUseCase",
              "_id": "atm-001257",
              "_parent": {
                "$ref": "atm-001252"
              },
              "name": "Consultar Saldo",
              "ownedElements": [
                {
                  "_type": "UMLInclude",
                  "_id": "atm-001291",
                  "_parent": {
                    "$ref": "atm-001257"
                  },
                  "source": {
                    "$ref": "atm-001257"
                  },
                  "target": {
                    "$ref": "atm-001256"
                  }
                }
              ],
              "extensionPoints": [
                {
                  "_type": "UMLExtensionPoint",
                  "_id": "atm-001292",
                  "_parent": {
                    "$ref": "atm-001257"
                  },
                  "name": "finDeOperacion",
                  "location": "",
                  "documentation": "Después de informar el resultado y antes de volver al menú"
                }
              ],
              "documentation": "Incluye Autenticar Usuario. Consultar saldo en Central, registrar resultado y mostrarlo. Punto de extensión al finalizar la operación."
            },
            {
              "_type": "UMLUseCase",
              "_id": "atm-001258",
              "_parent": {
                "$ref": "atm-001252"
              },
              "name": "Extraer Efectivo",
              "ownedElements": [
                {
                  "_type": "UMLInclude",
                  "_id": "atm-001294",
                  "_parent": {
                    "$ref": "atm-001258"
                  },
                  "source": {
                    "$ref": "atm-001258"
                  },
                  "target": {
                    "$ref": "atm-001256"
                  }
                }
              ],
              "extensionPoints": [
                {
                  "_type": "UMLExtensionPoint",
                  "_id": "atm-001295",
                  "_parent": {
                    "$ref": "atm-001258"
                  },
                  "name": "finDeOperacion",
                  "location": "",
                  "documentation": "Después de informar el resultado y antes de volver al menú"
                }
              ],
              "documentation": "Incluye Autenticar Usuario. Validar monto, solicitar autorización y débito atómico en Central; dispensar sólo si fue aprobado. Registrar y mostrar resultado."
            },
            {
              "_type": "UMLUseCase",
              "_id": "atm-001259",
              "_parent": {
                "$ref": "atm-001252"
              },
              "name": "Realizar Transferencia",
              "ownedElements": [
                {
                  "_type": "UMLInclude",
                  "_id": "atm-001297",
                  "_parent": {
                    "$ref": "atm-001259"
                  },
                  "source": {
                    "$ref": "atm-001259"
                  },
                  "target": {
                    "$ref": "atm-001256"
                  }
                }
              ],
              "extensionPoints": [
                {
                  "_type": "UMLExtensionPoint",
                  "_id": "atm-001298",
                  "_parent": {
                    "$ref": "atm-001259"
                  },
                  "name": "finDeOperacion",
                  "location": "",
                  "documentation": "Después de informar el resultado y antes de volver al menú"
                }
              ],
              "documentation": "Incluye Autenticar Usuario. Validar monto y destino, exigir confirmación y solicitar transferencia atómica a Central. No debitar dos veces. Registrar y mostrar comprobante."
            },
            {
              "_type": "UMLUseCase",
              "_id": "atm-001260",
              "_parent": {
                "$ref": "atm-001252"
              },
              "name": "Emitir ticket y Devolver Tarjeta",
              "ownedElements": [
                {
                  "_type": "UMLExtend",
                  "_id": "atm-001293",
                  "_parent": {
                    "$ref": "atm-001260"
                  },
                  "source": {
                    "$ref": "atm-001260"
                  },
                  "target": {
                    "$ref": "atm-001257"
                  },
                  "condition": "cliente solicita finalizar sesión",
                  "extensionLocations": [
                    {
                      "$ref": "atm-001292"
                    }
                  ]
                },
                {
                  "_type": "UMLExtend",
                  "_id": "atm-001296",
                  "_parent": {
                    "$ref": "atm-001260"
                  },
                  "source": {
                    "$ref": "atm-001260"
                  },
                  "target": {
                    "$ref": "atm-001258"
                  },
                  "condition": "cliente solicita finalizar sesión",
                  "extensionLocations": [
                    {
                      "$ref": "atm-001295"
                    }
                  ]
                },
                {
                  "_type": "UMLExtend",
                  "_id": "atm-001299",
                  "_parent": {
                    "$ref": "atm-001260"
                  },
                  "source": {
                    "$ref": "atm-001260"
                  },
                  "target": {
                    "$ref": "atm-001259"
                  },
                  "condition": "cliente solicita finalizar sesión",
                  "extensionLocations": [
                    {
                      "$ref": "atm-001298"
                    }
                  ]
                }
              ],
              "extensionPoints": [],
              "documentation": "Se extiende una operación cuando el cliente decide finalizar. Dentro del cierre el ticket es opcional, pero la devolución de tarjeta y el cierre de sesión son obligatorios. También puede iniciarse desde el menú sin operaciones previas."
            }
          ]
