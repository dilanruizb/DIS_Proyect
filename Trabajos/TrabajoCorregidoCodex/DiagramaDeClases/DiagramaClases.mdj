            {
              "_type": "UMLNoteView",
              "_id": "codex-atm-001249",
              "_parent": {
                "$ref": "codex-atm-000849"
              },
              "font": "Arial;13;0",
              "left": 40,
              "top": 25,
              "width": 1670,
              "height": 90,
              "text": "Decisiones del modelo: una tarjeta accede a una cuenta; una sesión tiene un cliente y una tarjeta. Sesion compone sus operaciones en memoria; el historial D1 persiste independientemente. Las clases no se subrayan. Operacion y ejecutar() son abstractos."
            }
          ]
