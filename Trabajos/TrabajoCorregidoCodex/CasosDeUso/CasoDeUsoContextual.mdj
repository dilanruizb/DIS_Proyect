            {
              "_type": "UMLNoteView",
              "_id": "codex-atm-001536",
              "_parent": {
                "$ref": "codex-atm-001300"
              },
              "font": "Arial;13;0",
              "left": 310,
              "top": 1020,
              "width": 980,
              "height": 100,
              "text": "include: siempre se garantiza la autenticación; se reutiliza la sesión válida. extend: finDeOperacion [cliente solicita finalizar sesión]. En el cierre, imprimir ticket es opcional; devolver tarjeta y cerrar son obligatorios."
            }
