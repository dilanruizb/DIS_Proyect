            {
              "_type": "UMLNoteView",
              "_id": "codex-atm-001671",
              "_parent": {
                "$ref": "codex-atm-001587"
              },
              "font": "Arial;13;0",
              "left": 310,
              "top": 1020,
              "width": 980,
              "height": 100,
              "text": "Objetivo: garantizar una sesión autenticada. Si la sesión ya está autenticada, devolver su contexto sin pedir nuevamente tarjeta/PIN. En caso contrario validar tarjeta en Sucursal y PIN en Central; máximo tres intentos. No persistir PIN."
            }
