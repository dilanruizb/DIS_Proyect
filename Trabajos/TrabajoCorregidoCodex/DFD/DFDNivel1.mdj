            "$ref": "atm-000436"
          },
          "target": {
            "$ref": "atm-000435"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000474",
          "_parent": {
            "$ref": "atm-000258"
          },
          "name": "Operación procesada",
          "documentation": "Resultado que se registra y presenta.\nComposición: RegistroOperacion + mensaje",
