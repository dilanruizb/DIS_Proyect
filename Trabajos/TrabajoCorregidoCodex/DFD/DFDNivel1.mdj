          },
          "name": "Solicitud de extracción",
          "documentation": "Monto y cuenta de una extracción.\nComposición: idSesion + numeroCuenta + monto",
          "source": {
            "$ref": "atm-000432"
          },
          "target": {
            "$ref": "atm-000433"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000458",
          "_parent": {
            "$ref": "atm-000258"
          },
          "name": "Contexto de sesión",
          "documentation": "Identidad y cuenta autenticadas para operar.\nComposición: idSesion + numeroTarjeta + numeroCuenta + autenticada",
          "source": {
            "$ref": "atm-000434"
          },
          "target": {
            "$ref": "atm-000433"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000461",
          "_parent": {
            "$ref": "atm-000258"
          },
          "name": "Operación preparada",
          "documentation": "Solicitud validada y datos de sesión asociados.\nComposición: tipoOperacion + ContextoSesion + [monto] + [cbuDestino]",
          "source": {
            "$ref": "atm-000433"
          },
          "target": {
            "$ref": "atm-000435"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000468",
          "_parent": {
            "$ref": "atm-000258"
          },
          "name": "Solicitud de débito",
          "documentation": "Autorización y débito atómico en Red Central.\nComposición: numeroCuenta + monto",
          "source": {
            "$ref": "atm-000435"
          },
          "target": {
            "$ref": "atm-000436"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000471",
          "_parent": {
            "$ref": "atm-000258"
          },
          "name": "Resultado de débito",
          "documentation": "Confirmación o rechazo de débito.\nComposición: exito + [numeroTransaccion] + saldoRestante + mensaje",
