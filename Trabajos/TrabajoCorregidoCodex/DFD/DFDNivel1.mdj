          },
          "name": "Solicitud de consulta",
          "documentation": "Elección de consulta de saldo.\nComposición: idSesion + numeroCuenta",
          "source": {
            "$ref": "atm-000372"
          },
          "target": {
            "$ref": "atm-000373"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000398",
          "_parent": {
            "$ref": "atm-000258"
          },
          "name": "Contexto de sesión",
          "documentation": "Identidad y cuenta autenticadas para operar.\nComposición: idSesion + numeroTarjeta + numeroCuenta + autenticada",
          "source": {
            "$ref": "atm-000374"
          },
          "target": {
            "$ref": "atm-000373"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000401",
          "_parent": {
            "$ref": "atm-000258"
          },
          "name": "Operación preparada",
          "documentation": "Solicitud validada y datos de sesión asociados.\nComposición: tipoOperacion + ContextoSesion + [monto] + [cbuDestino]",
          "source": {
            "$ref": "atm-000373"
          },
          "target": {
            "$ref": "atm-000375"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000408",
          "_parent": {
            "$ref": "atm-000258"
          },
          "name": "Solicitud de consulta de saldo",
          "documentation": "Petición al sistema central.\nComposición: numeroCuenta",
