        {
          "_type": "DFDDataFlow",
          "_id": "atm-000512",
          "_parent": {
            "$ref": "atm-000258"
          },
          "name": "Solicitud de transferencia",
          "documentation": "Datos y confirmación de una transferencia.\nComposición: idSesion + numeroCuenta + cbuDestino + monto + confirmacion",
          "source": {
            "$ref": "atm-000492"
          },
          "target": {
            "$ref": "atm-000493"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000518",
          "_parent": {
            "$ref": "atm-000258"
          },
          "name": "Contexto de sesión",
          "documentation": "Identidad y cuenta autenticadas para operar.\nComposición: idSesion + numeroTarjeta + numeroCuenta + autenticada",
          "source": {
            "$ref": "atm-000494"
          },
          "target": {
            "$ref": "atm-000493"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000521",
          "_parent": {
            "$ref": "atm-000258"
          },
          "name": "Operación preparada",
          "documentation": "Solicitud validada y datos de sesión asociados.\nComposición: tipoOperacion + ContextoSesion + [monto] + [cbuDestino]",
          "source": {
            "$ref": "atm-000493"
          },
          "target": {
            "$ref": "atm-000495"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000528",
          "_parent": {
            "$ref": "atm-000258"
          },
          "name": "Instrucción de transferencia",
          "documentation": "Orden atómica a Red Central.\nComposición: numeroCuenta + cbuDestino + monto",
          "source": {
            "$ref": "atm-000495"
          },
          "target": {
            "$ref": "atm-000496"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000531",
          "_parent": {
            "$ref": "atm-000258"
          },
          "name": "Resultado central de transferencia",
          "documentation": "Resultado, confirmación y comprobante central.\nComposición: exito + [numeroComprobante] + saldoRestante + mensaje",
          "source": {
            "$ref": "atm-000496"
          },
          "target": {
            "$ref": "atm-000495"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000534",
          "_parent": {
            "$ref": "atm-000258"
          },
          "name": "Operación procesada",
          "documentation": "Resultado que se registra y presenta.\nComposición: RegistroOperacion + mensaje",
          "source": {
            "$ref": "atm-000495"
          },
          "target": {
            "$ref": "atm-000497"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000540",
          "_parent": {
            "$ref": "atm-000258"
          },
          "name": "Registro de operación",
          "documentation": "Operación finalizada para el historial de la sesión.\nComposición: RegistroOperacion",
          "source": {
            "$ref": "atm-000497"
          },
          "target": {
            "$ref": "atm-000498"
          }
        },
        {
          "_type": "DFDDataFlow",
          "_id": "atm-000547",
          "_parent": {
            "$ref": "atm-000258"
          },
          "name": "Resultado de transferencia",
          "documentation": "Resultado y comprobante mostrado al cliente.\nComposición: ResultadoOperacion + [numeroComprobante] + saldoRestante",
          "source": {
            "$ref": "atm-000497"
          },
          "target": {
            "$ref": "atm-000492"
          }
        },
